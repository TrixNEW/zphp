#!/usr/bin/env python3
# Regenerates what zphp takes from php's own reflection for the natives and
# classes the two share:
#
#   src/stdlib/native_params_generated.zig    the parameter list of every native
#       function and method: names, defaults, which are required, which one is
#       variadic. named arguments to natives are placed and defaulted from it
#   src/stdlib/serialization_generated.zig    the internal classes php refuses
#       to serialize, and whether a subclass may opt back in by implementing
#       __serialize/__unserialize
#
# the native and class lists come from the running zphp binary, so they always
# match the build; the metadata comes from php, so run this with the php version
# zphp targets on PATH and regenerate after adding natives or classes:
#
#   make php-metadata
#
# natives and classes php does not have (the Zphp namespace) are written by hand
# in src/stdlib/native_params.zig and src/stdlib/serialize.zig.

import base64, json, os, subprocess, tempfile

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ZPHP = os.environ.get("ZPHP", os.path.join(REPO, "zig-out", "bin", "zphp"))
PARAMS_OUT = os.path.join(REPO, "src", "stdlib", "native_params_generated.zig")
SERIALIZATION_OUT = os.path.join(REPO, "src", "stdlib", "serialization_generated.zig")

LIST = "<?php foreach (get_defined_functions()['internal'] as $f) echo $f, \"\\n\";"
CLASSES = "<?php foreach (array_merge(get_declared_classes(), get_declared_interfaces()) as $c) echo $c, \"\\n\";"

# unserializing an empty instance is how php reveals the not-serializable flag
# without constructing anything; the dom classes carry their own wording
SERIALIZATION = r'''<?php
$out = [];
foreach (explode("\n", trim(stream_get_contents(STDIN))) as $class) {
    if (!class_exists($class) && !interface_exists($class)) continue;
    if (!(new ReflectionClass($class))->isInternal()) continue;
    try {
        @unserialize(sprintf('O:%d:"%s":0:{}', strlen($class), $class));
    } catch (Throwable $e) {
        $message = $e->getMessage();
        if (!str_contains($message, 'is not allowed')) continue;
        $out[$class] = str_contains($message, 'unless') ? 'unless_methods' : 'always';
    }
}
echo json_encode($out);
'''

REFLECT = r'''<?php
$out = [];
foreach (explode("\n", trim(stream_get_contents(STDIN))) as $name) {
    try {
        if (str_contains($name, '::')) {
            [$class, $method] = explode('::', $name, 2);
            if (!class_exists($class) && !interface_exists($class) && !enum_exists($class)) continue;
            if (!method_exists($class, $method)) continue;
            $r = new ReflectionMethod($class, $method);
        } else {
            if (!function_exists($name)) continue;
            $r = new ReflectionFunction($name);
        }
    } catch (Throwable) {
        continue;
    }
    $params = [];
    foreach ($r->getParameters() as $p) {
        $param = ['name' => $p->getName(), 'variadic' => $p->isVariadic()];
        if (!$p->isOptional()) {
            $param['default'] = ['kind' => 'required'];
        } elseif (!$p->isDefaultValueAvailable()) {
            $param['default'] = ['kind' => 'unknown'];
        } else {
            $v = $p->getDefaultValue();
            $param['default'] = match (true) {
                $v === null => ['kind' => 'null'],
                is_bool($v) => ['kind' => 'bool', 'value' => $v],
                is_int($v) => ['kind' => 'int', 'value' => $v],
                is_float($v) => ['kind' => 'float', 'value' => is_nan($v) ? 'nan' : (is_infinite($v) ? ($v > 0 ? 'inf' : '-inf') : $v)],
                is_string($v) => ['kind' => 'string', 'value' => base64_encode($v)],
                $v === [] => ['kind' => 'empty_array'],
                $v instanceof UnitEnum => ['kind' => 'class_constant', 'class' => get_class($v), 'name' => $v->name],
                default => ['kind' => 'unknown'],
            };
        }
        $params[] = $param;
    }
    $out[$name] = $params;
}
echo json_encode($out, JSON_PRESERVE_ZERO_FRACTION);
'''


def zig_string(raw: bytes) -> str:
    parts = []
    for b in raw:
        c = chr(b)
        if c == '"' or c == "\\":
            parts.append("\\" + c)
        elif 32 <= b < 127:
            parts.append(c)
        else:
            parts.append("\\x%02x" % b)
    return '"' + "".join(parts) + '"'


def zig_float(v) -> str:
    if v == "nan":
        return "std.math.nan(f64)"
    if v == "inf":
        return "std.math.inf(f64)"
    if v == "-inf":
        return "-std.math.inf(f64)"
    text = repr(float(v))
    return text if ("." in text or "e" in text) else text + ".0"


def zig_default(d) -> str:
    kind = d["kind"]
    if kind in ("required", "unknown", "null", "empty_array"):
        return "." + kind
    if kind == "bool":
        return ".{ .bool = %s }" % ("true" if d["value"] else "false")
    if kind == "int":
        return ".{ .int = %d }" % d["value"]
    if kind == "float":
        return ".{ .float = %s }" % zig_float(d["value"])
    if kind == "string":
        return ".{ .string = %s }" % zig_string(base64.b64decode(d["value"]))
    if kind == "class_constant":
        return ".{ .class_constant = .{ .class = %s, .name = %s } }" % (zig_string(d["class"].encode()), zig_string(d["name"].encode()))
    raise ValueError(kind)


def zig_param(p) -> str:
    fields = [".name = %s" % zig_string(p["name"].encode())]
    if p["default"]["kind"] != "required":
        fields.append(".default = %s" % zig_default(p["default"]))
    if p["variadic"]:
        fields.append(".variadic = true")
    return ".{ " + ", ".join(fields) + " }"


def run_script(binary, source, stdin=""):
    with tempfile.NamedTemporaryFile("w", suffix=".php", delete=False) as f:
        f.write(source)
    try:
        args = [binary, "run", f.name] if binary == ZPHP else [binary, "-d", "error_reporting=0", f.name]
        return subprocess.run(args, input=stdin, capture_output=True, text=True, check=True).stdout
    finally:
        os.unlink(f.name)


def main():
    names = run_script(ZPHP, LIST)
    signatures = json.loads(run_script("php", REFLECT, names))
    version = subprocess.run(["php", "-r", "echo PHP_VERSION;"], capture_output=True, text=True, check=True).stdout

    header = "// generated by scripts/gen-php-metadata from php %s reflection; do not edit" % version
    lines = [
        header,
        "const std = @import(\"std\");",
        "const Param = @import(\"native_params.zig\").Param;",
        "",
        "pub const map = std.StaticStringMap([]const Param).initComptime(.{",
    ]
    for name in sorted(signatures):
        body = ", ".join(zig_param(p) for p in signatures[name])
        lines.append("    .{ %s, &[_]Param{%s} }," % (zig_string(name.encode()), (" " + body + " ") if body else ""))
    lines.append("});")
    with open(PARAMS_OUT, "w") as f:
        f.write("\n".join(lines) + "\n")

    classes = run_script(ZPHP, CLASSES)
    rules = json.loads(run_script("php", SERIALIZATION, classes) or "{}")
    lines = [
        header,
        "const std = @import(\"std\");",
        "const Rule = @import(\"serialize.zig\").NotSerializable;",
        "",
        "pub const classes = std.StaticStringMap(Rule).initComptime(.{",
    ]
    for name in sorted(rules):
        lines.append("    .{ %s, Rule.%s }," % (zig_string(name.encode()), rules[name]))
    lines.append("});")
    with open(SERIALIZATION_OUT, "w") as f:
        f.write("\n".join(lines) + "\n")
    print("%d natives, %d not-serializable classes" % (len(signatures), len(rules)))


if __name__ == "__main__":
    main()
