#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
ZPHP=${ZPHP:-$ROOT/zig-out/bin/zphp}
SOURCE_APP="$ROOT/tests/serve/ws_app.php"
PORT=${ZPHP_STRESS_PORT:-19920}
ROUNDS=${ZPHP_STRESS_ROUNDS:-12}
REQUESTS=${ZPHP_STRESS_REQUESTS:-40}
CONCURRENCY=${ZPHP_STRESS_CONCURRENCY:-8}
TMP=$(mktemp -d "${TMPDIR:-/tmp}/zphp-stress.XXXXXX")
CERT="$TMP/cert.pem"
KEY="$TMP/key.pem"
LOG="$TMP/server.log"
APP="$TMP/ws_app.php"
cp "$SOURCE_APP" "$APP"

openssl req -x509 -newkey rsa:2048 -keyout "$KEY" -out "$CERT" -days 1 -nodes -subj /CN=localhost >/dev/null 2>&1
"$ZPHP" serve "$APP" --port "$PORT" --workers 2 --tls-cert "$CERT" --tls-key "$KEY" --watch >"$LOG" 2>&1 &
PID=$!
cleanup() {
    kill -TERM "$PID" 2>/dev/null || true
    wait "$PID" 2>/dev/null || true
    rm -rf "$TMP"
}
trap cleanup EXIT INT TERM

for _ in $(seq 1 100); do
    curl -sk --http2 --connect-timeout 2 --max-time 10 "https://127.0.0.1:$PORT/health" >/dev/null 2>&1 && break
    sleep 0.1
done
curl -sk --http2 --connect-timeout 2 --max-time 10 "https://127.0.0.1:$PORT/health" >/dev/null

rss_kb() {
    ps -o rss= -p "$PID" | awk '{print $1 + 0}'
}
fd_count() {
    if command -v lsof >/dev/null 2>&1; then
        lsof -n -p "$PID" 2>/dev/null | wc -l | tr -d ' '
    else
        find "/proc/$PID/fd" -mindepth 1 -maxdepth 1 2>/dev/null | wc -l | tr -d ' '
    fi
}
ws_round() {
    python3 - "$PORT" <<'PY'
import base64, os, socket, ssl, struct, sys
port = int(sys.argv[1])
raw = socket.create_connection(("127.0.0.1", port), timeout=5)
ctx = ssl.create_default_context()
ctx.check_hostname = False
ctx.verify_mode = ssl.CERT_NONE
s = ctx.wrap_socket(raw, server_hostname="localhost")
s.settimeout(5)
key = base64.b64encode(os.urandom(16)).decode()
s.sendall((f"GET / HTTP/1.1\r\nHost: localhost:{port}\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: {key}\r\nSec-WebSocket-Version: 13\r\n\r\n").encode())
headers = b""
while b"\r\n\r\n" not in headers:
    headers += s.recv(4096)
if b" 101 " not in headers.split(b"\r\n", 1)[0]:
    raise SystemExit("websocket upgrade failed")
def frame(msg):
    data = msg.encode(); mask = os.urandom(4)
    return bytes([0x81, 0x80 | len(data)]) + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(data))
def recv_frame():
    head = s.recv(2); n = head[1] & 0x7f
    if n == 126: n = struct.unpack("!H", s.recv(2))[0]
    return s.recv(n).decode()
if recv_frame() != "welcome": raise SystemExit("missing websocket welcome")
s.sendall(frame("ping"))
if recv_frame() != "pong": raise SystemExit("websocket echo failed")
s.close()
PY
}

BASE_RSS=$(rss_kb)
BASE_FDS=$(fd_count)
FIRST_MS=0
LAST_MS=0
round=1
while [ "$round" -le "$ROUNDS" ]; do
    start=$(python3 -c 'import time; print(time.monotonic_ns())')
    completed=0
    while [ "$completed" -lt "$REQUESTS" ]; do
        batch=$CONCURRENCY
        remaining=$((REQUESTS - completed))
        [ "$batch" -le "$remaining" ] || batch=$remaining
        i=0
        request_pids=""
        while [ "$i" -lt "$batch" ]; do
            curl -sk --http2 --connect-timeout 2 --max-time 10 "https://127.0.0.1:$PORT/health" >/dev/null &
            request_pids="$request_pids $!"
            i=$((i + 1))
        done
        for request_pid in $request_pids; do wait "$request_pid"; done
        completed=$((completed + batch))
    done
    ws_round
    if [ "$round" -eq $((ROUNDS / 2)) ]; then
        python3 - "$APP" <<'PY'
import os, sys, time
path = sys.argv[1]
now = time.time() + 2
os.utime(path, (now, now))
PY
        sleep 2
        curl -sk --http2 --connect-timeout 2 --max-time 10 "https://127.0.0.1:$PORT/health" >/dev/null
    fi
    stop=$(python3 -c 'import time; print(time.monotonic_ns())')
    elapsed=$(( (stop - start) / 1000000 ))
    [ "$round" -eq 1 ] && FIRST_MS=$elapsed
    LAST_MS=$elapsed
    round=$((round + 1))
done

END_RSS=$(rss_kb)
END_FDS=$(fd_count)
grep -q 'file change detected, reloading' "$LOG" || { echo "worker recycle did not occur"; cat "$LOG"; exit 1; }
RSS_GROWTH=$((END_RSS - BASE_RSS))
FD_GROWTH=$((END_FDS - BASE_FDS))
RSS_LIMIT_KB=${ZPHP_STRESS_RSS_LIMIT_KB:-32768}
FD_LIMIT=${ZPHP_STRESS_FD_LIMIT:-4}
THROUGHPUT_LIMIT=$((FIRST_MS * 2 + 50))

printf 'serve stress: rounds=%s requests=%s rss=%s->%sKB fds=%s->%s first=%sms last=%sms\n' "$ROUNDS" "$REQUESTS" "$BASE_RSS" "$END_RSS" "$BASE_FDS" "$END_FDS" "$FIRST_MS" "$LAST_MS"
[ "$RSS_GROWTH" -le "$RSS_LIMIT_KB" ] || { echo "RSS grew by ${RSS_GROWTH}KB (limit ${RSS_LIMIT_KB}KB)"; exit 1; }
[ "$FD_GROWTH" -le "$FD_LIMIT" ] || { echo "FD count grew by $FD_GROWTH (limit $FD_LIMIT)"; exit 1; }
[ "$LAST_MS" -le "$THROUGHPUT_LIMIT" ] || { echo "final round ${LAST_MS}ms exceeds stability limit ${THROUGHPUT_LIMIT}ms"; exit 1; }
